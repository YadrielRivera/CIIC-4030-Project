// UPRM-Edge Subproject 2 sample: int and float arithmetic
// Mixing int and float, negative floats, and functions that take and return floats.
// Floats print the way Python prints them (for example 6.0, not 6).
//
// expected output:
//   1.5
//   -5.0
//   0.5
//   3.5
//   2.5
//   -2.5
//   -6.0
//   3.5
//   0.5
//   true
//   true
//   9.75
//   -0.5
//   -1.0
// expected result: OK (exit code 0).

func half(x) {
    return x / 2.0;
}
func scale(x, f) {
    return x * f;
}
func average(a, b) {
    return (a + b) / 2.0;
}
print(1 + 0.5);
print(-2.5 * 2);
print(-0.5 + 1);
print(7 / 2.0);
print(half(5));
print(half(-5));
print(scale(-1.5, 4));
print(average(3, 4));
print(average(-3, 4));
print(2.5 > 2);
print(-2.5 < -2);
print(10 - 0.25);
let t = 0.5;
print(-t);
print(-t * 2);
