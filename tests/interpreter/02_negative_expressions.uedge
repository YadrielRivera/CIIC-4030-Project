// UPRM-Edge Subproject 2 sample: negative numbers inside expressions and calls
// Unary minus next to * and /, as a function argument, and applied to a function result.
//
// expected output:
//   -6
//   1
//   -6
//   6
//   -5
//   -4
//   4
//   7
//   7
//   12
//   -5
//   5
//   -7
//   7
//   -8
//   -8
//   7
//   -6
//   -4
// expected result: OK (exit code 0).

func absolute(n) {
    if (n < 0) {
        return -n;
    }
    return n;
}
func negate(n) {
    return -n;
}
func sub(a, b) {
    return a - b;
}
func twice(n) {
    return n * 2;
}
print(-2 * 3);
print(-2 + 3);
print(2 * -3);
print(-2 * -3);
print(10 / -2);
print(-8 / 2);
print(-8 / -2);
print(absolute(-7));
print(absolute(7));
print(absolute(0 - 12));
print(negate(5));
print(negate(-5));
print(sub(3, 10));
print(sub(-3, -10));
print(-twice(4));
print(twice(-4));
print(absolute(sub(2, 9)));
print(-absolute(-6));
print(absolute(-6) - absolute(-10));
