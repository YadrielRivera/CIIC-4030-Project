// UPRM-Edge Subproject 2 sample: loops combined with function calls
// A return from inside a loop, a function that returns -1, loops that count down,
// and loop conditions that compare against negative numbers.
//
// expected output:
//   30
//   7
//   -1
//   -5
//   -4
//   -3
//   -2
//   -1
//   0
//   10
//   5
//   0
//   1
//   -1
//   -3
// expected result: OK (exit code 0).

func isEven(n) {
    return n % 2 == 0;
}
func firstMultiple(k, limit) {
    for (let i = 1; i <= limit; i = i + 1) {
        if (i % k == 0) {
            return i;
        }
    }
    return -1;
}
func sumEvens(limit) {
    let total = 0;
    for (let j = 0; j <= limit; j = j + 1) {
        if (isEven(j)) {
            total = total + j;
        }
    }
    return total;
}
print(sumEvens(10));
print(firstMultiple(7, 30));
print(firstMultiple(7, 5));
for (let k = 5; k >= 0; k = k - 1) {
    print(k * -1);
}
for (let m = 10; m > -5; m = m - 5) {
    print(m);
}
let n = 3;
while (n > -3) {
    n = n - 2;
    print(n);
}
