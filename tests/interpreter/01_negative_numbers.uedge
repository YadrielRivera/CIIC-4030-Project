// UPRM-Edge Subproject 2 sample: negative numbers
// Negative literals, unary minus, and subtraction written with and without spaces.
// Your lexer must not read "5-3" as the two tokens 5 and -3.
//
// expected output:
//   -3
//   -4
//   -5
//   7
//   7
//   7
//   3
//   3
//   3
//   2
//   2
//   8
//   5
//   4
//   -5
//   -7
//   3
// expected result: OK (exit code 0).

let a = 4;
let b = -3;
print(b);
print(-a);
print(- 5);
print(a - b);
print(a-b);
print(a -b);
print(a - 1);
print(a-1);
print(a -1);
print(5-3);
print(5 -3);
print(5 - -3);
print(2 - (-3));
print(-(-4));
print(-(2 + 3));
print(0 - 7);
print(-b);
